# ==============================================================================
# ORX AGENTS PLATFORM — PRODUCTION ENVIRONMENT CONFIGURATION
# Deployment Target: agents.orxlabs.com (Oracle Cloud Arizona / Ampere A1 ARM64)
# ==============================================================================

# --- Networking & Core Domain ---
ENV=production
HOST=0.0.0.0
PORT=7860
PUBLIC_URL=https://agents.orxlabs.com
ORX_DOMAIN=agents.orxlabs
ORX_BRAND_NAME=ORX Agents

# --- Google Gemini 3.1 Flash (Primary Intelligence Engine) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_PROVIDER=gemini

# --- Groq LPU (Ultra-Fast Fallback LLM) ---
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b
GROQ_TEMPERATURE=0.35

# --- Speech-To-Text & Audio (Deepgram Flagship) ---
DEEPGRAM_API_KEY=f5c0803425b85a228f4ff16eb0d56b20be13d05c

# --- LiveKit WebRTC Engine ---
LIVEKIT_URL=ws://127.0.0.1:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret

# --- Telephony (Plivo & Telnyx SIP) ---
PLIVO_AUTH_ID=
PLIVO_AUTH_TOKEN=
PLIVO_PHONE_NUMBER=

TELNYX_API_KEY=
TELNYX_PHONE_NUMBER=+18334205227
TELNYX_SIP_CONNECTION_ID=

# --- Polar Billing Integration ---
POLAR_ACCESS_TOKEN=
POLAR_ORGANIZATION_ID=
POLAR_PRODUCT_ID_STARTER=polar_prod_starter
POLAR_PRODUCT_ID_GROWTH=polar_prod_growth
POLAR_CHECKOUT_URL=https://polar.sh/checkout

# --- Google Calendar OAuth 2.0 (1-Click Business Owner Sync) ---
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=https://agents.orxlabs.com/api/auth/google/callback

# --- Cloudflare Tunnel (Secure Zero-Port Ingress) ---
# Paste the token from Cloudflare Zero Trust > Networks > Tunnels
CLOUDFLARE_TUNNEL_TOKEN=
