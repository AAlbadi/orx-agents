# ==============================================================================
# ARIA VOICE AI AGENT CONFIGURATION (.env)
# ==============================================================================

# --- Environment & Networking ---
ENV=local
HOST=0.0.0.0
PORT=7860

# Public URL of your server (e.g. https://agent.yourdomain.com or Cloudflare Tunnel URL)
# Plivo will use this URL to establish WebSocket audio streams.
PUBLIC_URL=https://your-tunnel-domain.example.com

# --- Groq LLM Configuration ---
# Get your free API key at: https://console.groq.com/keys
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_TEMPERATURE=0.6

# --- Plivo Telephony Configuration ---
# Sign up at https://console.plivo.com/ to get your credentials and test credits
PLIVO_AUTH_ID=MAMXXXXXXXXXXXXXXXXX
PLIVO_AUTH_TOKEN=your_plivo_auth_token_here
# Your rented Plivo DID (E.164 format, e.g., +14155552671)
PLIVO_PHONE_NUMBER=+14155552671

# --- Speech-To-Text (Faster-Whisper STT) ---
# Models: tiny (fastest), base, small (recommended balance), medium
WHISPER_MODEL=small
WHISPER_DEVICE=cpu
# Compute type: int8 (fast on CPU / ARM64 Ampere), float32
WHISPER_COMPUTE_TYPE=int8

# --- Text-To-Speech (Kokoro ONNX TTS) ---
# Available voices: af_heart, af_bella, af_nicole, af_sarah, am_adam, am_michael
KOKORO_VOICE=af_heart

# --- Latency & Turn-Taking Tuning ---
# VAD stop seconds: pause duration before bot considers user finished speaking
VAD_STOP_SECS=0.35
VAD_CONFIDENCE=0.7

# Enable tool calling (weather, CRM lookup, scheduling, transfer)
ENABLE_TOOLS=true

# --- Cloudflare Tunnel (Optional) ---
# If using the docker-compose cloudflared service, paste your tunnel token from
# Cloudflare Zero Trust > Access > Tunnels:
CLOUDFLARE_TUNNEL_TOKEN=
